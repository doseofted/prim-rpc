{
	"name": "PrimRPC",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/devcontainers/features/node:2": {
			"version": "26",
			"pnpmVersion": "none"
		},
		"./features/corepack": {},
		"./features/lazygit": {},
		"./features/oh-my-zsh": {}
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/${localWorkspaceFolderBasename},type=bind",
	"workspaceFolder": "/home/vscode/${localWorkspaceFolderBasename}",
	"containerUser": "vscode",
	"mounts": [
		"source=${devcontainerId}-node_modules,target=/home/vscode/${localWorkspaceFolderBasename}/node_modules,type=volume"
	],
	"containerEnv": {
		"pnpm_config_store_dir": "/home/vscode/${localWorkspaceFolderBasename}/node_modules/.pnpm-store",
		"COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
	},
	"postCreateCommand": "sudo chown -R \"$USER:$USER\" node_modules && sudo chsh -s /bin/zsh \"$USER\" && pnpm install --frozen-lockfile --config.confirm-modules-purge=false && printf '%s\\n' 'alias task=\"pnpm task\"' 'alias lg=\"lazygit\"' >> \"$HOME/.zshrc\"",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"zsh": {
						"path": "/bin/zsh"
					}
				}
			},
			"extensions": [
				"redhat.vscode-yaml",
				"TypeScriptTeam.native-preview",
				"biomejs.biome",
				"streetsidesoftware.code-spell-checker",
				"vitest.explorer"
			]
		}
	}
}
